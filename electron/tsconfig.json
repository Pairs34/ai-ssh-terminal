{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "composite": true,
    "declaration": true,
    "outDir": "../dist-electron/types",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@database/*": ["database/*"]
    }
  },
  "include": ["main", "preload", "../database"]
}
